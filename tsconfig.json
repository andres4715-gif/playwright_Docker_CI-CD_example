{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "moduleResolution": "node",
        "sourceMap": false,
        "strict": true,
        "noImplicitAny": false, // This helps clear the "implicitly has an 'any' type" error
        "esModuleInterop": true,
        "lib": [
            "esnext",
            "dom",
            "dom.iterable"
        ],
        "types": [
            "node",
            "@playwright/test"
        ], // Crucial for Playwright types
        "allowJs": true,
        "skipLibCheck": true,
        "baseUrl": "."
    },
    "include": [
        "src/**/*.ts", // UPDATED: Points to your src folder
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}